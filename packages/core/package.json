{
  "name": "@jant/core",
  "version": "0.3.37",
  "description": "A modern, open-source microblogging platform built on Cloudflare Workers",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./i18n": "./src/i18n/index.ts"
  },
  "bin": {
    "jant": "bin/jant.js"
  },
  "files": [
    "bin",
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm build:lib && pnpm build:client",
    "build:client": "vite build --config vite.config.client.ts",
    "build:lib": "vite build --config vite.config.worker.ts",
    "typecheck": "tsc -b --noEmit",
    "db:generate": "drizzle-kit generate",
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile --typescript",
    "i18n:build": "pnpm i18n:extract && pnpm i18n:compile",
    "dev": "pnpm db:migrate:local && vite dev",
    "dev:debug": "pnpm db:migrate:local && vite dev --port 19020",
    "db:migrate:local": "echo y | wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "lingui compile --typescript",
    "prepublishOnly": "pnpm i18n:compile && pnpm build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.987.0",
    "@emoji-mart/data": "^1.2.1",
    "@lingui/core": "^5.9.0",
    "@lingui/react": "^5.9.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tiptap/core": "^3.20.0",
    "@tiptap/extension-image": "^3.20.0",
    "@tiptap/extension-placeholder": "^3.20.0",
    "@tiptap/extension-table": "^3.20.0",
    "@tiptap/pm": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "@tiptap/suggestion": "^3.20.0",
    "basecoat-css": "^0.3.10",
    "better-auth": "^1.4.18",
    "blurhash": "^2.0.5",
    "drizzle-orm": "^0.45.1",
    "emoji-mart": "^5.6.0",
    "fflate": "^0.8.2",
    "fractional-indexing": "^3.2.0",
    "heic-to": "^1.4.2",
    "limax": "^4.2.2",
    "lit": "^3.3.2",
    "lucide-static": "^0.574.0",
    "marked": "^17.0.1",
    "mediabunny": "^1.35.1",
    "nanoid": "^5.1.6",
    "smol-toml": "^1.6.0",
    "sortablejs": "^1.15.6",
    "tiptap-markdown": "^0.9.0",
    "uuidv7": "^1.1.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "hono": "^4.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.22.1",
    "@cloudflare/workers-types": "^4.20260131.0",
    "@lingui/cli": "^5.9.0",
    "@lingui/conf": "^5.9.0",
    "@lingui/format-po": "^5.9.0",
    "@lingui/swc-plugin": "^5.10.1",
    "@swc/core": "^1.15.11",
    "@tailwindcss/vite": "^4.1.18",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.1.0",
    "better-sqlite3": "^12.6.2",
    "drizzle-kit": "^0.31.8",
    "glob": "^13.0.0",
    "happy-dom": "^20.6.3",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.9",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "wrangler": "^4.61.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jant-me/jant.git",
    "directory": "packages/core"
  },
  "keywords": [
    "jant",
    "microblog",
    "cloudflare",
    "workers",
    "hono",
    "d1",
    "r2"
  ],
  "author": "Jant Contributors",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/jant-me/jant/issues"
  },
  "homepage": "https://jant.me",
  "engines": {
    "node": ">=24.0.0"
  }
}
