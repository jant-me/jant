{
  "name": "@jant/core",
  "version": "0.6.9",
  "description": "A modern, open-source microblogging platform built on Cloudflare Workers",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./src/node/index.ts",
      "default": "./dist/node.js"
    },
    "./i18n": "./src/i18n/index.ts"
  },
  "bin": {
    "jant": "bin/jant.js"
  },
  "files": [
    "bin",
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm build:client && pnpm build:site && pnpm build:lib",
    "build:client": "vite build --config vite.config.client.ts",
    "build:site": "vite build --config vite.config.site.ts",
    "build:lib": "node -e \"const{rmSync,readdirSync,existsSync}=require('fs');if(existsSync('dist'))readdirSync('dist').filter(f=>f!=='client').forEach(f=>rmSync('dist/'+f,{recursive:true,force:true}))\" && vite build --config vite.config.worker.ts",
    "brand:generate": "tsx dev/scripts/generate-brand-assets.ts",
    "typecheck": "tsc -b --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:generate:pg": "drizzle-kit generate --config drizzle.config.pg.ts",
    "fonts:generate:cjk": "node dev/scripts/generate-noto-serif-cjk.mjs all",
    "fonts:generate:sc": "node dev/scripts/generate-noto-serif-cjk.mjs sc",
    "fonts:generate:tc": "node dev/scripts/generate-noto-serif-cjk.mjs tc",
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile --typescript",
    "i18n:coverage": "node dev/scripts/compute-i18n-coverage.mjs",
    "i18n:build": "pnpm i18n:extract && pnpm i18n:compile && pnpm i18n:coverage",
    "dev": "pnpm db:migrate:local && vite dev",
    "dev:node": "vite dev --config vite.config.node.ts --mode node --host 0.0.0.0",
    "dev:debug": "node dev/scripts/start-dev-debug.mjs",
    "db:migrate:local": "node ./bin/jant.js migrate --local",
    "db:migrate:remote": "node ./bin/jant.js migrate --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "lingui compile --typescript && pnpm i18n:coverage",
    "prepublishOnly": "pnpm i18n:compile && pnpm i18n:coverage && pnpm build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1012.0",
    "@aws-sdk/s3-request-presigner": "^3.1016.0",
    "@emoji-mart/data": "^1.2.1",
    "@fontsource-variable/literata": "^5.2.8",
    "@fontsource-variable/newsreader": "^5.2.10",
    "@fontsource-variable/source-sans-3": "^5.2.9",
    "@fontsource/news-cycle": "^5.2.7",
    "@hono/node-server": "^1.19.11",
    "@lingui/core": "^5.9.3",
    "@lingui/react": "^5.9.3",
    "@tailwindcss/typography": "^0.5.19",
    "@tiptap/core": "^3.22.1",
    "@tiptap/extension-code-block": "^3.22.1",
    "@tiptap/extension-image": "^3.22.1",
    "@tiptap/extension-placeholder": "^3.22.1",
    "@tiptap/extension-table": "^3.22.1",
    "@tiptap/markdown": "^3.22.1",
    "@tiptap/pm": "^3.22.1",
    "@tiptap/starter-kit": "^3.22.1",
    "@tiptap/suggestion": "^3.22.1",
    "basecoat-css": "^0.3.11",
    "better-auth": "^1.5.5",
    "better-sqlite3": "^12.8.0",
    "blurhash": "^2.0.5",
    "drizzle-orm": "^0.45.1",
    "emoji-mart": "^5.6.0",
    "fflate": "^0.8.2",
    "fractional-indexing": "^3.2.0",
    "heic-to": "^1.4.2",
    "limax": "^4.2.2",
    "lit": "^3.3.2",
    "lucide-static": "^0.577.0",
    "marked": "^17.0.4",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mediabunny": "^1.39.2",
    "micromark-extension-gfm": "^3.0.0",
    "nanoid": "^5.1.7",
    "parse5": "^8.0.0",
    "pg": "^8.20.0",
    "smol-toml": "^1.6.0",
    "sortablejs": "^1.15.7",
    "typeid-js": "^1.2.0",
    "unist-util-visit": "^5.1.0",
    "uqr": "^0.1.3",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "hono": "^4.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.29.1",
    "@cloudflare/workers-types": "^4.20260317.1",
    "@fontsource/noto-serif-jp": "^5.2.8",
    "@fontsource/noto-serif-kr": "^5.2.9",
    "@fontsource/noto-serif-sc": "^5.2.9",
    "@fontsource/noto-serif-tc": "^5.2.9",
    "@lingui/cli": "^5.9.3",
    "@lingui/conf": "^5.9.3",
    "@lingui/format-po": "^5.9.3",
    "@lingui/swc-plugin": "^5.11.0",
    "@swc/core": "^1.15.18",
    "@tailwindcss/vite": "^4.2.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "cn-font-split": "^7.4.1",
    "drizzle-kit": "^0.31.10",
    "glob": "^13.0.6",
    "happy-dom": "^20.8.4",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "unplugin-swc": "^1.5.9",
    "vite": "^8.0.0",
    "vitest": "^4.1.0",
    "wrangler": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jant-me/jant.git",
    "directory": "packages/core"
  },
  "keywords": [
    "jant",
    "microblog",
    "cloudflare",
    "workers",
    "hono",
    "d1",
    "r2"
  ],
  "author": "Jant Contributors",
  "license": "AGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/jant-me/jant/issues"
  },
  "homepage": "https://jant.me",
  "engines": {
    "node": ">=24.0.0"
  }
}
