#. @context: Warning in the multilingual dialog about stamping posts that have no language
#: src/ui/dash/settings/LanguageContent.tsx
msgid "{count, plural, one {# existing post} other {# existing posts}} with no language yet will be marked as {language}."
msgstr "{count, plural, other {其中 # 篇还没有语言，会标记为「{language}」。}}"

#. @context: Error when a content language that posts still use would be dropped
#: src/routes/dash/settings.tsx
msgid "{count, plural, one {# post is} other {# posts are}} still written in {language}. Change their language, or keep the language."
msgstr "{count, plural, other {还有 # 篇{language}文章。先修改它们的语言，或保留该语言。}}"

#. @context: Refusal in the multilingual dialog when the list drops a language that posts still use
#: src/routes/dash/settings.tsx
msgid "{count, plural, one {# post is} other {# posts are}} written in {language}, which is not on this list. Add it back, or change their language first."
msgstr "{count, plural, other {还有 # 篇{language}文章，但列表里没有这个语言。把它加回列表，或先修改这些文章的语言。}}"

#. @context: Config Editor live search result count
#: src/ui/dash/settings/ConfigEditorContent.tsx
msgid "{count} settings shown"
msgstr "{count} 个设置已显示"

#. @context: Body of the dialog confirming removal of the last additional language
#: src/ui/dash/settings/LanguageContent.tsx
msgid "{language} is the only other language on this site, so removing it turns multilingual content off. The root address goes back to showing every language, {prefix} stops working, and each post keeps the language it is written in."
msgstr "移除 {language} 后就只剩主语言了，多语言会一并关闭。根地址将恢复显示所有语言，{prefix} 不再可用，每篇文章的语言保持不变。"

#. @context: Body of the change-primary-language dialog
#: src/ui/dash/settings/LanguageContent.tsx
msgid "{next} will be served at the root address (/, /feed, /archive), and {previous} moves to {prefix}. Post addresses do not change, but anyone subscribed to /feed starts receiving {next} posts."
msgstr "根地址（/、/feed、/archive）将改为提供「{next}」的内容，「{previous}」移至 {prefix}。文章地址不会改变，但订阅了 /feed 的读者从此收到的是「{next}」的文章。"

