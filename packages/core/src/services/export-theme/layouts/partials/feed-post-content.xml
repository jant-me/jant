{{- /*
  Feed entry content builder — mirrors `buildSinglePostContent` +
  `buildFeedContent` from `packages/core/src/lib/feed.ts`.

  Arguments (dict):
    post           — the Hugo Page for this post
    permalink      — absolute permalink to the blog post (used for the
                     link-format "★" suffix)
    includeReplies — when true, appends each public reply separated by
                     <hr/> + <small><time></time></small>
    inline         — when true, renders title/link metadata that top-level
                     Atom entries expose through their entry fields

  Output is raw HTML suitable for embedding inside Atom
  <content type="html"><![CDATA[...]]></content>. Since CDATA ends at the
  first `]]>`, any such sequence in rendered bodies is split using
  `replace ... "]]>" "]]]]><![CDATA[>"` — the same trick the main site uses
  in `escapeCdata`.
*/ -}}
{{- $post := .post -}}
{{- $permalink := .permalink -}}
{{- $includeReplies := .includeReplies -}}
{{- $inline := false -}}
{{- with .inline -}}{{- $inline = . -}}{{- end -}}
{{- $format := $post.Params.format | default "note" -}}
{{- $parts := slice -}}

{{- /* --- Inline title/link metadata for thread replies --- */ -}}
{{- if and $inline (ne $format "quote") -}}
  {{- $title := $post.Title | default "" -}}
  {{- $linkUrl := string ($post.Params.link_url | default "") -}}
  {{- if eq $format "link" -}}
    {{- if ne $linkUrl "" -}}
      {{- $domain := $linkUrl -}}
      {{- with urls.Parse $linkUrl -}}{{- if .Host -}}{{- $domain = replaceRE `^(www|m|mobile)\.` "" .Host -}}{{- end -}}{{- end -}}
      {{- $parts = $parts | append (printf `<p><a href=%q>%s</a></p>` $linkUrl (transform.XMLEscape $domain)) -}}
    {{- end -}}
    {{- if ne $title "" -}}
      {{- $titleHref := $permalink -}}
      {{- if ne $linkUrl "" -}}{{- $titleHref = $linkUrl -}}{{- end -}}
      {{- $parts = $parts | append (printf `<h2><a href=%q>%s</a></h2>` $titleHref (transform.XMLEscape $title)) -}}
    {{- end -}}
  {{- else if ne $title "" -}}
    {{- $parts = $parts | append (printf `<h2><a href=%q>%s</a></h2>` $permalink (transform.XMLEscape $title)) -}}
  {{- end -}}
{{- end -}}

{{- /* --- Quote block (format=quote) --- */ -}}
{{- if eq $format "quote" -}}
  {{- $quoteText := string ($post.Params.quote_text | default "") -}}
  {{- if ne $quoteText "" -}}
    {{- $sourceName := string ($post.Params.source_name | default "") -}}
    {{- $sourceUrl := string ($post.Params.source_url | default "") -}}
    {{- $cite := "" -}}
    {{- if ne $sourceUrl "" -}}{{- $cite = printf ` cite=%q` $sourceUrl -}}{{- end -}}
    {{- /* Line breaks the author typed must survive as markup: the site
         keeps them with `white-space: pre-line`, but feed readers strip
         CSS. Blank lines split <p> blocks, single newlines become <br/>
         (mirrors `renderPlainTextHtml` in `lib/feed.ts`). */ -}}
    {{- $quoteBlocks := slice -}}
    {{- range split (replaceRE `\r\n?` "\n" $quoteText) "\n\n" -}}
      {{- $para := trim . " \t\n" -}}
      {{- if ne $para "" -}}
        {{- $lines := slice -}}
        {{- range split $para "\n" -}}{{- $lines = $lines | append (transform.XMLEscape .) -}}{{- end -}}
        {{- $quoteBlocks = $quoteBlocks | append (printf "<p>%s</p>" (delimit $lines "<br/>")) -}}
      {{- end -}}
    {{- end -}}
    {{- if gt (len $quoteBlocks) 0 -}}
      {{- $block := printf "<blockquote%s>%s</blockquote>" $cite (delimit $quoteBlocks "\n") -}}
      {{- $parts = $parts | append $block -}}
    {{- end -}}
    {{- /* Attribution line — prefer name, fall back to URL host or the
         raw URL itself (mirrors main site's extractDisplayDomain fallback
         chain in `lib/url.ts`). */ -}}
    {{- $attribution := "" -}}
    {{- if and (ne $sourceName "") (ne $sourceUrl "") -}}
      {{- $attribution = printf `<a href=%q>%s</a>` $sourceUrl (transform.XMLEscape $sourceName) -}}
    {{- else if ne $sourceName "" -}}
      {{- $attribution = transform.XMLEscape $sourceName -}}
    {{- else if ne $sourceUrl "" -}}
      {{- $host := $sourceUrl -}}
      {{- with urls.Parse $sourceUrl -}}{{- if .Host -}}{{- $host = .Host -}}{{- end -}}{{- end -}}
      {{- $attribution = printf `<a href=%q>%s</a>` $sourceUrl (transform.XMLEscape $host) -}}
    {{- end -}}
    {{- if ne $attribution "" -}}
      {{- $parts = $parts | append (printf "<p>— %s</p>" $attribution) -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- /* --- Rendered body HTML (with <script>/<style> stripped) --- */ -}}
{{- $body := $post.Content -}}
{{- if ne (string $body) "" -}}
  {{- $bodyStr := string $body -}}
  {{- $bodyStr = replaceRE `(?is)<script\b[^>]*>.*?</script>` "" $bodyStr -}}
  {{- $bodyStr = replaceRE `(?is)<style\b[^>]*>.*?</style>` "" $bodyStr -}}
  {{- /* Split any CDATA-terminator sequences so the content can be safely
       wrapped in <![CDATA[...]]> by the caller. */ -}}
  {{- $bodyStr = replace $bodyStr "]]>" "]]]]><![CDATA[>" -}}
  {{- if ne (trim $bodyStr " \t\n\r") "" -}}
    {{- $parts = $parts | append $bodyStr -}}
  {{- end -}}
{{- end -}}

{{- /* --- Attachments --- */ -}}
{{- /* One container per post, marked `data-post-media` — the attribute the
     site puts on its gallery strip, so a consumer styles the strip instead of
     reassembling it from the Media RSS elements. In a thread this is also the
     only surface that says which post an attachment belongs to. Mirrors
     `renderMediaItem` in `packages/core/src/lib/feed.ts`. */ -}}
{{- $mediaList := $post.Params.media | default slice -}}
{{- if gt (len $mediaList) 0 -}}
  {{- $items := slice -}}
  {{- range $mediaList -}}
    {{- $kind := string (.kind | default "document") -}}
    {{- $mime := string (.mime_type | default "application/octet-stream") -}}
    {{- /* `trim` wraps the index rather than piping into it: a Go template
         pipe binds to the last argument, so `index … 0 | trim " "` would trim
         the index instead of the result. */ -}}
    {{- $mimeLabel := trim (index (split $mime ";") 0) " " -}}
    {{- $src := (string .src) | absURL -}}
    {{- $name := string (.original_name | default "") -}}
    {{- $alt := string (.alt | default "") -}}
    {{- /* Duration and size, in the shapes `formatFeedDuration` and
         `formatFeedBytes` produce. */ -}}
    {{- $metaParts := slice -}}
    {{- with .duration_seconds -}}
      {{- $total := int (math.Round .) -}}
      {{- if gt $total 0 -}}
        {{- $metaParts = $metaParts | append (printf "%d:%02d" (div $total 60) (mod $total 60)) -}}
      {{- end -}}
    {{- end -}}
    {{- with .size -}}
      {{- $b := int . -}}
      {{- if gt $b 0 -}}
        {{- if lt $b 1024 -}}
          {{- $metaParts = $metaParts | append (printf "%d B" $b) -}}
        {{- else if lt $b 1048576 -}}
          {{- $metaParts = $metaParts | append (printf "%d KB" (int (math.Round (div (float $b) 1024.0)))) -}}
        {{- else -}}
          {{- $metaParts = $metaParts | append (printf "%.1f MB" (div (float $b) 1048576.0)) -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
    {{- $meta := delimit $metaParts " · " -}}
    {{- $metaSuffix := "" -}}
    {{- if ne $meta "" -}}{{- $metaSuffix = printf " (%s)" (transform.XMLEscape $meta) -}}{{- end -}}
    {{- $dims := "" -}}
    {{- if and .width .height -}}{{- $dims = printf ` width="%d" height="%d"` (int .width) (int .height) -}}{{- end -}}

    {{- if eq $kind "image" -}}
      {{- $caption := "" -}}
      {{- if ne $alt "" -}}{{- $caption = printf "<figcaption>%s</figcaption>" (transform.XMLEscape $alt) -}}{{- end -}}
      {{- /* `%q` is Go string quoting, not attribute escaping: a `"` or `\`
           in the alt would leave the attribute malformed. URLs go through
           `%q` because they never carry either; author text goes through
           `transform.XMLEscape`, the same as the caption beside it. */ -}}
      {{- $items = $items | append (printf `<figure><a href=%q><img src=%q alt="%s"%s/></a>%s</figure>` $src $src (transform.XMLEscape $alt) $dims $caption) -}}
    {{- else if eq $kind "video" -}}
      {{- /* A poster is written only when there is a real still; the pipeline
           leaves nothing usable otherwise, and `<img src="clip.mp4">` was the
           bug that taught us. The link sits outside the <video> so it survives
           a sanitizer that drops the player with its children, and
           `preload="none"` keeps a reader from pulling the whole file. */ -}}
      {{- $posterAttr := "" -}}
      {{- with .poster -}}{{- $posterAttr = printf ` poster=%q` ((string .) | absURL) -}}{{- end -}}
      {{- $altSuffix := "" -}}
      {{- if ne $alt "" -}}{{- $altSuffix = printf ": %s" (transform.XMLEscape $alt) -}}{{- end -}}
      {{- $items = $items | append (printf `<figure><video controls preload="none"%s%s><source src=%q type=%q/></video><figcaption><a href=%q>▶ Watch video</a>%s%s</figcaption></figure>` $posterAttr $dims $src $mimeLabel $src $metaSuffix $altSuffix) -}}
    {{- else if eq $kind "text" -}}
      {{- /* Markdown a browser would download or dump unstyled, so the link
           goes to the page that renders it. */ -}}
      {{- $href := printf "%s/text/%s" (strings.TrimSuffix "/" $permalink) (string .id) -}}
      {{- $label := printf "📎 [%s] %s" (transform.XMLEscape $mimeLabel) (transform.XMLEscape (or $name "Attached text")) -}}
      {{- $textMeta := $metaSuffix -}}
      {{- with .chars -}}
        {{- if gt (int .) 0 -}}{{- $textMeta = printf " (%d chars)" (int .) -}}{{- end -}}
      {{- end -}}
      {{- $summarySuffix := "" -}}
      {{- with .summary -}}
        {{- if ne (string .) "" -}}{{- $summarySuffix = printf ": %s" (transform.XMLEscape (string .)) -}}{{- end -}}
      {{- end -}}
      {{- $items = $items | append (printf `<p><a href=%q>%s</a>%s%s</p>` $href $label $textMeta $summarySuffix) -}}
    {{- else -}}
      {{- $fallbackName := cond (eq $kind "audio") "Audio" "Attachment" -}}
      {{- $label := printf "📎 [%s] %s" (transform.XMLEscape $mimeLabel) (transform.XMLEscape (or $name $fallbackName)) -}}
      {{- $items = $items | append (printf `<p><a href=%q>%s</a>%s</p>` $src $label $metaSuffix) -}}
    {{- end -}}
  {{- end -}}
  {{- $parts = $parts | append (printf "<div data-post-media>\n%s\n</div>" (delimit $items "\n")) -}}
{{- end -}}

{{- /* --- Star rating --- */ -}}
{{- with $post.Params.rating -}}
  {{- $r := int . -}}
  {{- if gt $r 0 -}}
    {{- $filled := strings.Repeat $r "★" -}}
    {{- $empty := strings.Repeat (sub 5 $r) "☆" -}}
    {{- $parts = $parts | append (printf "<p>%s%s %d/5</p>" $filled $empty $r) -}}
  {{- end -}}
{{- end -}}

{{- /* --- Empty-body fallback (plain-text summary) --- */ -}}
{{- if eq (len $parts) 0 -}}
  {{- $fallback := string ($post.Params.summary_text | default "") -}}
  {{- if eq $fallback "" -}}{{- $fallback = $post.Title | default (printf "Post %s" (string ($post.Params.id | default ""))) -}}{{- end -}}
  {{- $parts = $parts | append (printf "<p>%s</p>" (transform.XMLEscape $fallback)) -}}
{{- end -}}

{{- /* --- link-format permalink suffix (Daring Fireball ★) --- */ -}}
{{- if and (eq $format "link") (ne $permalink "") -}}
  {{- $parts = $parts | append (printf `<p><a href=%q title="Permalink">&nbsp;★&nbsp;</a></p>` $permalink) -}}
{{- end -}}

{{- /* --- Thread replies --- */ -}}
{{- if $includeReplies -}}
  {{- $replies := where $post.Pages "Params.visibility" "public" -}}
  {{- $replies = $replies.ByDate -}}
  {{- range $replies -}}
    {{- $replyPermalink := .Permalink -}}
    {{- $replyDatetime := .Date.UTC.Format "2006-01-02T15:04:05Z" -}}
    {{- /* Human-readable timestamp; mirrors the main site's
         `publishedAtFormatted` in the feed — there it's locale-formatted
         by `lib/format-timestamp.ts`, but Hugo doesn't have that at
         export time, so use a simple ISO-style fallback. */ -}}
    {{- $replyLabel := .Date.Format "Jan 2, 2006 15:04" -}}
    {{- $parts = $parts | append "<hr/>" -}}
    {{- $parts = $parts | append (printf `<p><small><time datetime=%q>%s</time></small></p>` $replyDatetime (transform.XMLEscape $replyLabel)) -}}
    {{- $parts = $parts | append (partial "feed-post-content.xml" (dict "post" . "permalink" $replyPermalink "includeReplies" false "inline" true)) -}}
  {{- end -}}
{{- end -}}

{{- delimit $parts "\n" | safeHTML -}}
