{{- /*
  Atom 2005 feed template — mirrors the main site's `lib/feed.ts`.

  One template covers every page that opts into the custom `RSS` output
  format (home, featured, archive, and each collection section). Root-post
  sections do NOT opt in, so no `/{slug}/index.xml` gets emitted.

  Feed filter parity with the corresponding HTML list view:
    - home   (`.Kind == "home"`): visibility == "public" (drops latest_hidden)
    - featured (`.Type == "featured"`): one Root per Thread whose derived
        featured projection is non-empty, ordered by selected Post publication
    - archive  (`.Type == "archive"`): all published (includes latest_hidden)
    - collection (`.Type == "collection"`): Params.collections.slug match,
        ordered per `sort_order`; pinning is ignored for RSS

  Per-entry payload mirrors `buildSinglePostContent` + `buildFeedContent`:
    - Title: empty for quote posts, else .Title
    - Link rel=alternate: external URL for `link` format, else permalink;
      link-format posts also get a <link rel="related"> back to the
      permalink
    - Content (CDATA):
        quote   → <blockquote cite><p>{quote}</p></blockquote>
                  + <p>— <a href=url>{source}</a></p>
        body    → Hugo-rendered .Content (stripped of <script>/<style>)
        rating  → <p>★★★★☆ 4/5</p>
        link    → trailing <p><a href=permalink> ★ </a></p>
        replies → <hr/> + <p><small><time>{dt}</time></small></p>
                  + inline title/link metadata + content

  Hugo's default RSS media-type override (`[outputFormats.RSS]`) makes this
  template produce application/atom+xml at /{section}/index.xml.
*/ -}}
{{- $page := . -}}
{{- $limit := int (.Site.Params.rss_feed_limit | default 50) -}}
{{- $allPosts := where .Site.Pages "Type" "post" -}}
{{- $rootPosts := where $allPosts "Kind" "section" -}}

{{- /* ------------------------------------------------------------------
     Post selection per feed kind
     ------------------------------------------------------------------ */ -}}
{{- $posts := slice -}}
{{- $isFeatured := eq $page.Type "featured" -}}

{{- if eq $page.Kind "home" -}}
  {{- $public := where $allPosts "Params.visibility" "public" -}}
  {{- $posts = $public.ByDate.Reverse -}}
{{- else if $isFeatured -}}
  {{- $featured := where $rootPosts "Params.featured_sort_at" "ne" nil -}}
  {{- $posts = sort $featured "Params.featured_sort_at" "desc" -}}
{{- else if eq $page.Type "archive" -}}
  {{- $posts = $allPosts.ByDate.Reverse -}}
{{- else if eq $page.Type "collection" -}}
  {{- $collectionSlug := $page.Params.slug | default $page.Slug -}}
  {{- $members := slice -}}
  {{- range $rootPosts -}}
    {{- $post := . -}}
    {{- with $post.Params.collections -}}
      {{- range . -}}
        {{- if eq .slug $collectionSlug -}}
          {{- $members = $members | append (dict "post" $post "entry" .) -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
  {{- $sortOrder := $page.Params.sort_order | default "position" -}}
  {{- $ordered := $members -}}
  {{- if $ordered -}}
    {{- if eq $sortOrder "collected_at_desc" -}}
      {{- $ordered = sort $ordered "entry.collected_at" "desc" -}}
    {{- else -}}
      {{- $ordered = sort $ordered "entry.position" "asc" -}}
    {{- end -}}
  {{- end -}}
  {{- range $ordered -}}{{- $posts = $posts | append .post -}}{{- end -}}
{{- end -}}

{{- if gt (len $posts) $limit -}}
  {{- $posts = first $limit $posts -}}
{{- end -}}

{{- /* ------------------------------------------------------------------
     Feed title (mirrors the main site's Atom feed titles)
     ------------------------------------------------------------------ */ -}}
{{- $feedTitle := .Site.Title -}}
{{- if eq $page.Kind "home" -}}
  {{- $feedTitle = printf "%s - Latest posts" .Site.Title -}}
{{- else if $isFeatured -}}
  {{- $feedTitle = printf "%s - Featured posts" .Site.Title -}}
{{- else if eq $page.Type "archive" -}}
  {{- $feedTitle = printf "%s - Archive" .Site.Title -}}
{{- else if eq $page.Type "collection" -}}
  {{- $feedTitle = printf "%s - %s" .Site.Title $page.Title -}}
{{- end -}}

{{- $siteDescription := .Site.Params.description | default "" -}}
{{- $siteBase := .Site.BaseURL -}}
{{- $selfUrl := .Permalink -}}
{{- $now := now.UTC.Format "2006-01-02T15:04:05Z" -}}
<?xml version="1.0" encoding="UTF-8"?>
{{- /* Namespaces ride along only when something in them is emitted, the same
     rule `lib/feed.ts` follows. */ -}}
{{- $anyMedia := false -}}
{{- range $posts -}}
  {{- if .Params.media -}}{{- $anyMedia = true -}}{{- end -}}
  {{- range .Pages -}}{{- if .Params.media -}}{{- $anyMedia = true -}}{{- end -}}{{- end -}}
{{- end -}}
{{- $jantNs := cond (gt (len $posts) 0) ` xmlns:jant="https://jant.me/ns"` "" -}}
{{- $mediaNs := cond $anyMedia ` xmlns:media="http://search.yahoo.com/mrss/"` "" -}}
<feed xmlns="http://www.w3.org/2005/Atom"{{ $jantNs | safeHTMLAttr }}{{ $mediaNs | safeHTMLAttr }}>
  <title>{{ $feedTitle | transform.XMLEscape }}</title>
  <subtitle>{{ $siteDescription | transform.XMLEscape }}</subtitle>
  <link href="{{ $siteBase | transform.XMLEscape }}" rel="alternate"/>
  <link href="{{ $selfUrl | transform.XMLEscape }}" rel="self"/>
  <id>{{ $selfUrl | transform.XMLEscape }}</id>
  <updated>{{ $now }}</updated>
  {{- range $posts }}
  {{- $post := . -}}
  {{- $format := .Params.format | default "note" -}}
  {{- $permalink := .Permalink -}}
  {{- $isLink := and (eq $format "link") .Params.link_url -}}
  {{- $alternate := cond $isLink (string .Params.link_url) $permalink -}}
  {{- /* Atom <title>: empty for quotes (matches main site's getAtomTitle). */ -}}
  {{- $entryTitle := cond (eq $format "quote") "" (.Title | default "") -}}
  {{- /* <published>: from `date` frontmatter (= publishedAt).
       <updated>: prefer `last_activity_at` (thread-bumped), then `updated`
       (root edit time), else `date`. Featured membership does not rewrite
       content time or chronological ordering. */ -}}
  {{- $published := .Date.UTC.Format "2006-01-02T15:04:05Z" -}}
  {{- $updatedSrc := .Date -}}
  {{- with .Params.last_activity_at -}}{{- $updatedSrc = time . -}}
  {{- else -}}{{- with .Params.updated -}}{{- $updatedSrc = time . -}}{{- end -}}{{- end -}}
  {{- $updated := $updatedSrc.UTC.Format "2006-01-02T15:04:05Z" -}}
  {{- /* Plain-text summary fallback chain (mirrors getFeedSummaryText). */ -}}
  {{- $summaryText := "" -}}
  {{- if eq $format "quote" -}}
    {{- $summaryText = or (string (.Params.summary_text | default "")) (string (.Params.quote_text | default "")) (.Title | default "") (string (.Params.link_url | default "")) (string (.Params.source_url | default "")) -}}
  {{- else -}}
    {{- $summaryText = or (string (.Params.summary_text | default "")) (.Title | default "") (string (.Params.link_url | default "")) -}}
  {{- end -}}
  {{- if eq $summaryText "" -}}{{- $summaryText = printf "Post %s" (string (.Params.id | default "")) -}}{{- end -}}

  {{- /* Whether the timeline cut the text of any post the entry's card shows.
       Per post it is written into front matter by the exporter, which shares
       the boundary with the served feed; Hugo's own summary rule would cut
       somewhere else. Per entry the rule is `isEntryTruncated` in
       `lib/feed.ts`: the root plus every reply the fold keeps — the first
       THREAD_LEADING_REPLIES (2) and the last THREAD_TRAILING_REPLIES (3),
       newest included — as `lib/thread-fold.ts` defines it. A thread of five
       replies or fewer is shown whole; `first` and `last` clamp to the slice,
       so the two windows simply overlap there. */ -}}
  {{- $replies := (where $post.Pages "Params.visibility" "public").ByDate -}}
  {{- $truncated := $post.Params.truncated | default false -}}
  {{- range first 2 $replies -}}
    {{- if .Params.truncated -}}{{- $truncated = true -}}{{- end -}}
  {{- end -}}
  {{- range last 3 $replies -}}
    {{- if .Params.truncated -}}{{- $truncated = true -}}{{- end -}}
  {{- end -}}

  {{- /* Every attachment in the thread, each paired with the post that carries
       it — a text attachment's page lives under its own post. */ -}}
  {{- $entryMedia := slice -}}
  {{- range ($post.Params.media | default slice) -}}
    {{- $entryMedia = $entryMedia | append (dict "m" . "page" $permalink) -}}
  {{- end -}}
  {{- range $replies -}}
    {{- $replyPermalink := .Permalink -}}
    {{- range (.Params.media | default slice) -}}
      {{- $entryMedia = $entryMedia | append (dict "m" . "page" $replyPermalink) -}}
    {{- end -}}
  {{- end -}}
  <entry>
    <title>{{ $entryTitle | transform.XMLEscape }}</title>
    <link href="{{ $alternate | transform.XMLEscape }}" rel="alternate"/>
    {{- if $isLink }}
    <link href="{{ $permalink | transform.XMLEscape }}" rel="related"/>
    {{- end }}
    {{- /* Images carry no enclosure: the content already shows them full size
         inside a link to the original, so one would only ask an attachment
         shelf to list the picture again. */ -}}
    {{- range $entryMedia }}
    {{- $m := .m }}
    {{- if ne (string ($m.kind | default "document")) "image" }}
    <link rel="enclosure" type="{{ (string ($m.mime_type | default "application/octet-stream")) | transform.XMLEscape }}" href="{{ (string $m.src) | absURL | transform.XMLEscape }}"{{ with $m.size }} length="{{ . }}"{{ end }}{{ with $m.original_name }} title="{{ . | transform.XMLEscape }}"{{ end }}/>
    {{- end }}
    {{- end }}
    <id>{{ $permalink | transform.XMLEscape }}</id>
    <published>{{ $published }}</published>
    <updated>{{ $updated }}</updated>
    <jant:format>{{ $format | transform.XMLEscape }}</jant:format>
    {{- if $truncated }}
    <jant:truncated/>
    {{- end }}
    {{- /* A collection is a label the author chose, which is what <category>
         is for. `jant:page` carries the URL because a single collection lives
         in the root URL namespace. */ -}}
    {{- range ($post.Params.collections | default slice) }}
    <category term="{{ (string .slug) | transform.XMLEscape }}" label="{{ (string (.title | default .slug)) | transform.XMLEscape }}" jant:page="{{ (printf "/%s/" (string .slug)) | absURL | transform.XMLEscape }}"/>
    {{- end }}
    {{- range $entryMedia }}
    {{- $m := .m }}
    {{- $kind := string ($m.kind | default "document") }}
    {{- $medium := cond (or (eq $kind "image") (or (eq $kind "video") (eq $kind "audio"))) $kind "document" }}
    {{- $fileUrl := (string $m.src) | absURL }}
    {{- /* Where a click should land. Only emitted where it is not the file:
         a text attachment's markdown would download or dump unstyled. */ -}}
    {{- $pageUrl := $fileUrl }}
    {{- if eq $kind "text" }}{{ $pageUrl = printf "%s/text/%s" (strings.TrimSuffix "/" .page) (string $m.id) }}{{ end }}
    {{- $desc := string ($m.alt | default ($m.summary | default "")) }}
    {{- $poster := string ($m.poster | default "") }}
    <media:content url="{{ $fileUrl | transform.XMLEscape }}" type="{{ (string ($m.mime_type | default "application/octet-stream")) | transform.XMLEscape }}" medium="{{ $medium }}"{{ with $m.size }} fileSize="{{ . }}"{{ end }}{{ with $m.width }} width="{{ . }}"{{ end }}{{ with $m.height }} height="{{ . }}"{{ end }}{{ with $m.duration_seconds }} duration="{{ math.Round . }}"{{ end }}{{ if ne $pageUrl $fileUrl }} jant:page="{{ $pageUrl | transform.XMLEscape }}"{{ end }}>
      {{- with $m.original_name }}<media:title type="plain">{{ . | transform.XMLEscape }}</media:title>{{ end }}
      {{- if ne $desc "" }}<media:description type="plain">{{ $desc | transform.XMLEscape }}</media:description>{{ end }}
      {{- if ne $poster "" }}<media:thumbnail url="{{ $poster | absURL | transform.XMLEscape }}"/>{{ end -}}
    </media:content>
    {{- end }}
    <summary type="text">{{ $summaryText | transform.XMLEscape }}</summary>
    <content type="html"><![CDATA[
{{- partial "feed-post-content.xml" (dict "post" $post "permalink" $permalink "includeReplies" true) -}}
]]></content>
  </entry>
  {{- end }}
</feed>
