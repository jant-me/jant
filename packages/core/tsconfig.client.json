{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/client.ts",
    "src/client-auth.ts",
    "src/client-compose.ts",
    "src/client-settings.ts",
    "src/client-manage.ts",
    "src/client-site.ts",
    "src/client/**/*.ts",
    "src/types/**/*.d.ts"
  ]
}
