# Node development environment example for `pnpm dev:node`.
#
# Copy this file to `packages/core/.env.node`, then uncomment only the
# variables you need. Replace the `AUTH_SECRET` placeholder with a real
# 32+ character secret (e.g. `openssl rand -base64 32`) before starting Jant.

# Required authentication secret. Must be at least 32 characters.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=replace-me-replace-me-replace-me-replace-me-replace-me

# Public site URL for canonical URLs, RSS, sitemaps, and auth callbacks.
# Leave `SITE_ORIGIN` unset to use the current request origin.
# `SITE_PATH_PREFIX` is only needed when Jant is mounted under a subpath.
# SITE_ORIGIN=http://127.0.0.1:3000
# SITE_PATH_PREFIX=/blog

# Node listener settings for `jant start` or `pnpm dev:node`.
# HOST=127.0.0.1
# PORT=3000
# TRUST_PROXY=false

# Node runtime database and local media paths.
# For `pnpm dev:node`, Jant defaults to `packages/core/data` when these are
# unset. Uncomment only if you want another location or a different database.
# DATA_DIR=/absolute/path/to/jant-data
# DATABASE_URL=file:/absolute/path/to/jant-data/jant.sqlite
# LOCAL_STORAGE_PATH=/absolute/path/to/jant-data/media
# LOCAL_PUBLIC_URL=https://media.your-jant.example

# Use Postgres instead of SQLite.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# Storage driver selection for Node.
# `local` is the default on Node.
# STORAGE_DRIVER=local

# S3-compatible storage for uploads and media.
# Set `STORAGE_DRIVER=s3` and then configure the options below.
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_BUCKET=my-bucket
# S3_REGION=us-east-1
# S3_PUBLIC_URL=https://cdn.example.com
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key

# Optional image transformation base URL.
# IMAGE_TRANSFORM_URL=https://media.your-jant.example/cdn-cgi/image

# CDN base URL for built JS/CSS assets (Node/Docker only).
# When set, all asset URLs in rendered HTML point to this CDN instead of the app origin.
# Run `mise run upload-assets` to upload built assets to S3 before deploying.
# ASSET_BASE_URL=https://cdn.example.com

# Optional site defaults. These can also be changed later in Settings.
# DEFAULT_THEME=linen
# SITE_NAME=Jant
# SITE_DESCRIPTION=
# SITE_LANGUAGE=en
# MAIN_RSS_FEED=featured
# TIME_ZONE=UTC
# SITE_FOOTER=Published with Jant
# SHOW_JANT_BRANDING_ON_HOME=false
# NOINDEX=false

# Optional pagination and feed limits.
# `SEARCH_PAGE_SIZE` and `ARCHIVE_PAGE_SIZE` fall back to `PAGE_SIZE` when unset.
# PAGE_SIZE=25
# SEARCH_PAGE_SIZE=25
# ARCHIVE_PAGE_SIZE=25
# RSS_FEED_LIMIT=50
# 0 disables the delay; maximum 7200 seconds.
# RSS_PUBLISH_DELAY_SECONDS=300

# Optional upload, summary, and slug tuning.
# UPLOAD_MAX_FILE_SIZE_MB=1024
# SUMMARY_MAX_PARAGRAPHS=5
# SUMMARY_MAX_CHARS=500
# SLUG_ID_LENGTH=5
