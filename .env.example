# Deployment environment example for Docker Compose and single-instance Node
# deployments.
#
# Copy this file to `.env`, then uncomment only the variables you need.
# Replace the `AUTH_SECRET` placeholder with a real 32+ character secret
# (e.g. `openssl rand -base64 32`) before you start Jant.
#
# This is the public Docker/Node template used by the deployment docs.
# Repo automation such as demo rebuild/publish uses `.env.repo.example`
# instead of this file.

# Required authentication secret. Must be at least 32 characters.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=replace-me-replace-me-replace-me-replace-me-replace-me

# Docker Compose only: override the published image tag or host port.
# IMAGE=owenyoung/jant:latest
# HOST_PORT=3000

# Public site URL for canonical URLs, RSS, sitemaps, and auth callbacks.
# Leave `SITE_ORIGIN` unset to use the current request origin.
# `SITE_PATH_PREFIX` is only needed when Jant is mounted under a subpath.
# SITE_ORIGIN=https://your-jant.example
# SITE_PATH_PREFIX=/blog

# Node/Docker listener settings.
# The official Docker image already defaults to `HOST=0.0.0.0` and `PORT=3000`.
# `TRUST_PROXY=true` is recommended when the container sits behind Caddy,
# Nginx, Traefik, or another reverse proxy you control.
# HOST=0.0.0.0
# PORT=3000
# TRUST_PROXY=true

# Node runtime database and local media paths.
# The official Docker image already defaults `DATA_DIR` to `/var/lib/jant`.
# If you leave `DATABASE_URL` unset, Jant derives SQLite from `DATA_DIR`.
# DATA_DIR=/var/lib/jant
# DATABASE_URL=file:/var/lib/jant/jant.sqlite
# LOCAL_STORAGE_PATH=/var/lib/jant/media
# LOCAL_PUBLIC_URL=https://media.your-jant.example

# Use Postgres instead of SQLite.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# Storage driver selection for Node/Docker.
# `local` is the default on Node/Docker.
# STORAGE_DRIVER=local

# S3-compatible storage for uploads and media.
# Set `STORAGE_DRIVER=s3` and then configure the options below.
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_BUCKET=my-bucket
# S3_REGION=us-east-1
# S3_PUBLIC_URL=https://cdn.example.com
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key

# Optional image transformation base URL.
# Set this to the domain that serves your images, plus `/cdn-cgi/image`.
# IMAGE_TRANSFORM_URL=https://media.your-jant.example/cdn-cgi/image

# Optional site defaults. These can also be changed later in Settings.
# DEFAULT_THEME=linen
# SITE_NAME=Jant
# SITE_DESCRIPTION=
# SITE_LANGUAGE=en
# MAIN_RSS_FEED=featured
# TIME_ZONE=UTC
# SITE_FOOTER=Published with Jant
# SHOW_JANT_BRANDING_ON_HOME=false
# NOINDEX=false

# Optional pagination and feed limits.
# `SEARCH_PAGE_SIZE` and `ARCHIVE_PAGE_SIZE` fall back to `PAGE_SIZE` when unset.
# PAGE_SIZE=25
# SEARCH_PAGE_SIZE=25
# ARCHIVE_PAGE_SIZE=25
# RSS_FEED_LIMIT=50
# 0 disables the delay; maximum 7200 seconds.
# RSS_PUBLISH_DELAY_SECONDS=300

# Optional upload, summary, and slug tuning.
# UPLOAD_MAX_FILE_SIZE_MB=1024
# SUMMARY_MAX_PARAGRAPHS=5
# SUMMARY_MAX_CHARS=500
# SLUG_ID_LENGTH=5
